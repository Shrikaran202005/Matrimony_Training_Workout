# Node.js
node_modules/

# TypeScript compiled JavaScript
*.js

# Keep JavaScript files that are actually source files
!src/**/*.js

# TypeScript build files
*.tsbuildinfo

# Environment variables
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

